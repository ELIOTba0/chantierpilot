# --- Base de données (Supabase) ---
# Côté serveur uniquement (webhook et fonctions Retell). La clé
# service_role contourne le RLS : jamais de préfixe NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Côté navigateur (tableau de bord). La clé anon est publique par
# nature : c'est le RLS qui protège les données.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Retell ---
# Secret du webhook, à récupérer dans le tableau de bord Retell
RETELL_WEBHOOK_SECRET=
# Clé que TU choisis, à mettre en en-tête des custom functions Retell
# (en-tête : x-chantierpilot-cle)
RETELL_FUNCTION_SECRET=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
